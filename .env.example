# Copia este archivo como .env y completa los valores

# Base de datos PostgreSQL
# DATABASE_URL: conexión que usa la app (puede ser la del pooler, ej. Supabase/Neon)
# DIRECT_URL: conexión directa que usa Prisma para las migraciones
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bumnation
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/bumnation

# JWT (mínimo 16 caracteres, usa uno largo y aleatorio en producción)
JWT_SECRET=cambia-esto-por-un-secreto-largo

# Cloudinary (imágenes de productos y usuarios): https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# App
PORT=3000
NODE_ENV=development

# URL(s) del frontend permitidas por CORS, separadas por coma
FRONTEND_URL=http://localhost:3001
